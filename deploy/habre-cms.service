# Installed to /etc/systemd/system/ by deploy/setup-server.sh.
[Unit]
Description=Habre CMS
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=habre_cms
Group=habre_cms
# `deploy` points this symlink at the release to run.
WorkingDirectory=/srv/habre-cms/current
# Non-secret settings live here; secrets only in the mode-600 file.
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=APP_URL=https://cms.surenmaharjan.fyi
EnvironmentFile=/etc/habre-cms/production.env
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=5

# The app keeps no state on disk (D9), so it gets a read-only view of the system.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
