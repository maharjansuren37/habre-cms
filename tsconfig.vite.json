{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "app/**/.server/**/*",
    "app/**/.client/**/*",
    "server/**/*",
    "db/**/*",
    "scripts/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "types": ["node", "vite/client"],
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    // Editor.js ships .ts type sources containing `enum`, which erasableSyntaxOnly
    // forbids and skipLibCheck does not cover. app/types/editorjs.d.ts describes
    // what we use; Vite still bundles the real packages.
    "paths": {
      "@editorjs/editorjs": ["./app/types/editorjs.d.ts"],
      "@editorjs/header": ["./app/types/editorjs.d.ts"],
      "@editorjs/list": ["./app/types/editorjs.d.ts"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
