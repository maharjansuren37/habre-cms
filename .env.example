# Copy to .env for local development and fill in values. Never commit .env.

# --- Read by the app now ---
# Port the Node server listens on (localhost only). Default 3000.
PORT=
# postgres://habre_cms:<DEV_DB_PASSWORD>@127.0.0.1:5432/habre_cms in development.
# The only variable the scripts (db:migrate, create-admin) need.
DATABASE_URL=
# Public site's origin and the admin's origin (D22 - the hostname split).
# Both http://127.0.0.1:3000 in development (equal origins mean the app
# redirects nothing); the real https:// addresses in production (https on
# ADMIN_URL is what makes the session cookie Secure).
PUBLIC_URL=
ADMIN_URL=
# Signs session tokens; at least 32 characters. Generate one per environment:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Changing it logs everyone out.
JWT_SECRET=

# --- Development database (compose.yaml only) ---
# Superuser password for the local container
DEV_POSTGRES_PASSWORD=
# Password for the habre_cms role; must match DATABASE_URL
DEV_DB_PASSWORD=

# --- Needed by later items (not read yet) ---
# Item 5 - images
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# NODE_ENV is set by the npm scripts (dev/start), not here.
