# Copy to .env for local development and fill in values. Never commit .env.

# --- Read by the app now ---
# Port the Node server listens on (localhost only). Default 3000.
PORT=
# The app role habre_cms_app, which owns nothing (D152):
# postgres://habre_cms_app:<DEV_APP_DB_PASSWORD>@127.0.0.1:5432/habre_cms in development.
# The web app and create-admin read it.
DATABASE_URL=
# The owner role habre_cms, for migrations and the browser tests' setup:
# postgres://habre_cms:<DEV_DB_PASSWORD>@127.0.0.1:5432/habre_cms in development.
# db:migrate needs this one; the web app never reads it.
DATABASE_OWNER_URL=
# The platform's origin (sign-in, signup, admin) and the sites origin: a site
# is served at <address>.<sites host>. Development: PLATFORM_URL=http://app.localhost:3000
# and SITES_URL=http://localhost:3000, which puts site 1 at
# http://surenmaharjan.localhost:3000. Production uses the real https:// origins;
# https on PLATFORM_URL is what makes the session cookie Secure. Both must be
# origins with no path. On the server they must agree with Caddy's two domains
# in /etc/caddy/habre-cms.env: PLATFORM_URL=https://app.$HABRE_PLATFORM_DOMAIN
# and SITES_URL=https://$HABRE_SITES_DOMAIN.
PLATFORM_URL=
SITES_URL=
# Signs session tokens; at least 32 characters. Generate one per environment:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Changing it logs everyone out.
JWT_SECRET=
# R2 (Cloudflare object storage) - where uploaded images live. The app
# refuses to start without all five. Use a bucket and token scoped to
# development only - never reuse a production token here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The address images are served from - the bucket's own r2.dev address is
# fine for development; a production deployment wants a custom domain.
R2_PUBLIC_URL=
# Signup (item 15b). off (default; /signup is Not Found), invite or open.
# invite or open needs SMTP_URL and EMAIL_FROM, or the app will not start.
SIGNUP_MODE=
# Where email is sent: smtp://127.0.0.1:1025 in development (Mailpit, started
# by docker compose; read it at http://127.0.0.1:8025). Production, Resend:
# smtps://resend:<key>@smtp.resend.com:465. smtp:// is accepted only for a
# loopback host. SMTP_URL and EMAIL_FROM go together: one alone stops startup.
# Setting both also turns on password reset by email.
SMTP_URL=
# The sender, as Name <address>. Production needs a domain you have verified
# with the provider.
EMAIL_FROM=
# Each site's media storage limit, in MB (1 MB = 1,048,576 bytes). Blank gives
# 500. none removes the limit. Anything else stops startup.
STORAGE_LIMIT_MB=
# The same for a Launch (paid) site (item 21a). Blank gives 10240 (10 GB), or
# STORAGE_LIMIT_MB when that is higher. Lower than STORAGE_LIMIT_MB stops startup.
LAUNCH_STORAGE_LIMIT_MB=

# --- AI (item 18b1) ---
# AI is on when the first provider in AI_PROVIDERS has its key (by default
# OPENROUTER_API_KEY); blank or unset turns AI off. When AI is on, every listed
# provider needs its key, and a listed anthropic or openai also needs its model
# and price, or startup stops naming the missing variable.
OPENROUTER_API_KEY=
# Providers in the order to try, from openrouter, anthropic, openai; blank
# gives openrouter. Anything else stops startup. `fake` is for the browser
# tests only: no network, no key; it must be the only name listed, and startup
# refuses it unless PLATFORM_URL is localhost, a *.localhost name, 127.0.0.1
# or [::1]. Never set it in production.
AI_PROVIDERS=
# The OpenRouter model id; blank gives anthropic/claude-opus-5.5.
OPENROUTER_MODEL=
# Direct providers. No default model, because a price belongs to one model.
# A price is input=<n>,output=<n>,cache_read=<n>,cache_write=<n>, all four,
# each a number from 0, in US dollars per million tokens. A malformed price
# stops startup even when AI is off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_PRICE=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PRICE=
# Credits a site may use a month (1 credit = US$0.001 of provider cost). Blank
# gives 1000. none removes the limit. Anything else stops startup.
AI_CREDITS_PER_MONTH=
# The same for a Launch (paid) site (item 21a). Blank gives 6000, or
# AI_CREDITS_PER_MONTH when that is higher. Lower than AI_CREDITS_PER_MONTH
# stops startup.
LAUNCH_AI_CREDITS_PER_MONTH=

# --- Development database (compose.yaml only) ---
# Superuser password for the local container
DEV_POSTGRES_PASSWORD=
# Password for the habre_cms (owner) role; must match DATABASE_OWNER_URL
DEV_DB_PASSWORD=
# Password for the habre_cms_app role; must match DATABASE_URL
DEV_APP_DB_PASSWORD=

# NODE_ENV is set by the npm scripts (dev/start), not here.
