{
  "extends": "./tsconfig.json",
  "include": [
    "server.js",
    "vite.config.ts",
    "playwright.config.ts",
    "e2e/**/*",
    "app/features/legal/legal-documents.ts",
    "app/features/own-domain/own-domain-store.server.ts",
    "app/features/own-domain/own-domain.ts",
    "app/features/own-domain/own-domain-checker.ts",
    "app/features/own-domain/own-domain-dns.server.ts",
    "app/features/own-domain/own-domain-schedule.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2024"],
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler"
  }
}
