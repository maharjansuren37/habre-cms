{
  "name": "habre-cms",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "imports": {
    "#app/*": "./app/*"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env server.js",
    "build": "react-router build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server.js",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.ts",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.ts",
    "create-invite": "node --env-file-if-exists=.env scripts/create-invite.ts",
    "suspend-site": "node --env-file-if-exists=.env scripts/suspend-site.ts",
    "unsuspend-site": "node --env-file-if-exists=.env scripts/unsuspend-site.ts",
    "set-plan": "node --env-file-if-exists=.env scripts/set-plan.ts",
    "optimise-media": "node --env-file-if-exists=.env scripts/optimise-media.ts",
    "ai:try": "node --env-file-if-exists=.env scripts/ai-try.ts",
    "ai:measure": "node --env-file-if-exists=.env scripts/ai-measure.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@react-router/node": "8.4.0",
    "@remix-run/node-fetch-server": "0.14.2",
    "@tiptap/core": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "aws4fetch": "1.0.20",
    "image-size": "2.0.4",
    "isbot": "5.2.2",
    "jose": "6.2.12",
    "nodemailer": "10.0.14",
    "openai": "7.30.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sharp": "0.35.5",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@types/node": "26.5.1",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
